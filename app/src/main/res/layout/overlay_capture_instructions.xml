<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/instructions_scrim"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="26dp"
        android:layout_marginRight="26dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/capture_instructions_title"
                android:textColor="@color/glass_content"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/capture_instructions_subtitle"
                android:textColor="@color/sphere_accent"
                android:textSize="14sp" />

            <include
                android:id="@+id/step_1"
                layout="@layout/item_instruction_step" />

            <include
                android:id="@+id/step_2"
                layout="@layout/item_instruction_step" />

            <include
                android:id="@+id/step_3"
                layout="@layout/item_instruction_step" />

            <include
                android:id="@+id/step_4"
                layout="@layout/item_instruction_step" />

            <include
                android:id="@+id/step_5"
                layout="@layout/item_instruction_step" />

            <Button
                android:id="@+id/button_instructions_dismiss"
                style="@style/Widget.PhotoSphere.PillButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="@string/capture_instructions_dismiss" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
