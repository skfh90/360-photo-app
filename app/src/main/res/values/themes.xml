<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhotoSphere" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/sphere_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/sphere_background</item>
        <item name="android:textColorPrimary">@color/sphere_on_surface</item>
        <item name="android:textColorSecondary">@color/sphere_on_surface_variant</item>
        <item name="colorPrimary">@color/sphere_accent</item>
        <item name="colorPrimaryDark">@color/sphere_background</item>
        <item name="colorAccent">@color/sphere_accent</item>
    </style>

    <style name="Widget.PhotoSphere.PillButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_pill_accent</item>
        <item name="android:textColor">@color/sphere_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="Widget.PhotoSphere.OutlinedPill" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_pill_outlined</item>
        <item name="android:textColor">@color/glass_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <style name="Widget.PhotoSphere.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/glass_content</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Theme.PhotoSphere.Splash" parent="Theme.PhotoSphere">
        <item name="android:windowBackground">@color/sphere_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@color/sphere_background</item>
    </style>

    <style name="Theme.PhotoSphere.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorPrimary">@color/sphere_accent</item>
        <item name="colorAccent">@color/sphere_accent</item>
        <item name="android:textColorPrimary">@color/sphere_on_surface</item>
    </style>
</resources>
